rules_version = '2';
// Formulaire de contact commun du portefeuille (14/10/2026) : « ne jamais exposer l'email de mythadubiz, on utilise
// un formulaire ». ÉCRITURE SEULE, champs validés ; aucune lecture publique (l'éditeur lit en console / par script).
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['app', 'lang', 'email', 'message', 'topic', 'page', 'subject', 'context'])
        && request.resource.data.keys().hasAll(['app', 'email', 'message'])
        && request.resource.data.app is string && request.resource.data.app.matches('^[a-z0-9-]{2,40}$')
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.message is string && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && (!('lang' in request.resource.data) || (request.resource.data.lang is string && request.resource.data.lang.size() <= 10))
        && (!('topic' in request.resource.data) || request.resource.data.topic in ['support', 'privacy', 'other'])
        && (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 200))
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
        && (!('context' in request.resource.data) || request.resource.data.context in ['support', 'privacy', 'terms', 'legal']);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
